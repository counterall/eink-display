{
  "name": "kindle-display",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "refresh:trending": "node scripts/refresh-trending.mjs",
    "test": "vitest run",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:legacy": "node scripts/check-legacy.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "lucide-react": "^1.70.0",
    "lunar-javascript": "^1.7.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "ignoredBuiltDependencies": ["core-js"]
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.4.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "cheerio": "^1.2.0",
    "stylelint": "^18.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "terser": "^5.39.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  },
  "browserslist": ["Safari >= 9", "Chrome >= 49"]
